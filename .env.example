# --- LLM provider -----------------------------------------------------------
# openrouter (default) serves the assignment's mandated reasoning model exactly and
# the current Gemma release for extraction. Groq decommissioned both mandated models.
# llm_provider=openrouter

openrouter_api_key=sk-or-v1-your_key_here     # https://openrouter.ai/keys
groq_api_key=gsk_your_key_here                # https://console.groq.com/keys  (llm_provider=groq)

# Optional overrides. Defaults per provider:
#   openrouter -> google/gemma-3-12b-it        + meta-llama/llama-3.3-70b-instruct
#   groq       -> openai/gpt-oss-20b           + openai/gpt-oss-120b
# extraction_model=google/gemma-3-12b-it
# reasoning_model=meta-llama/llama-3.3-70b-instruct

# --- Database ---------------------------------------------------------------
# Omit to use SQLite; set this to use the Postgres in docker-compose.yml.
# database_url=postgresql+psycopg2://aivoa:aivoa@localhost:5432/aivoa_qms
